# ── Public URLs ───────────────────────────────────────────────────────────────
MCP_PUBLIC_BASE_URL=https://mcp.xelta.ai
MCP_RESOURCE_URL=https://mcp.xelta.ai/mcp
OAUTH_ISSUER=https://mcp.xelta.ai

# ── OAuth storage ─────────────────────────────────────────────────────────────
OAUTH_DB_PATH=/data/oauth.db

# ── OAuth TTLs ────────────────────────────────────────────────────────────────
OAUTH_ACCESS_TOKEN_TTL_SECONDS=3600
OAUTH_AUTH_CODE_TTL_SECONDS=300
OAUTH_REFRESH_TOKEN_TTL_DAYS=30

# ── Consent page security ─────────────────────────────────────────────────────
CONSENT_SESSION_SECRET=change-me-in-production

# ── Xelta IdP (OAuth 2.0 endpoints for user login) ───────────────────────────
# These endpoints are implemented in the Xelta backend (McpOAuthController.js).
# The authorization flow is:
#   1. MCP server → GET /authorize → backend stores pending state, redirects to frontend login
#   2. Frontend login → GET /continue?pending=<key>&token=<jwt> → backend issues auth code
#   3. MCP server ← code in callback ← redirect from /continue
#   4. MCP server → POST /token (exchange code) → backend returns Xelta JWT
#   5. MCP server → GET /userinfo → backend returns { id, email }
#
# Redirect URI that must be registered in the Xelta backend's MCP_REDIRECT_URI env var:
#   Production: https://mcp.xelta.ai/auth/xelta/callback
#   Local dev:  http://localhost:8000/auth/xelta/callback

# Production values (backend team sets MCP_CLIENT_SECRET to a strong random value):
XELTA_AUTH_AUTHORIZE_URL=https://api.xelta.ai/api/auth/oauth/authorize
XELTA_AUTH_TOKEN_URL=https://api.xelta.ai/api/auth/oauth/token
XELTA_AUTH_USERINFO_URL=https://api.xelta.ai/api/auth/oauth/userinfo
XELTA_AUTH_CLIENT_ID=xelta-mcp-server
XELTA_AUTH_CLIENT_SECRET=change-me-to-a-strong-random-secret
XELTA_AUTH_REDIRECT_URI=https://mcp.xelta.ai/auth/xelta/callback
XELTA_AUTH_SCOPES=openid email profile

# ── Local dev overrides (uncomment to test full OAuth flow against local backend) ──
# Requires backend running on localhost:5000 with matching MCP_REDIRECT_URI and BACKEND_URL.
# XELTA_AUTH_AUTHORIZE_URL=http://localhost:5000/api/auth/oauth/authorize
# XELTA_AUTH_TOKEN_URL=http://localhost:5000/api/auth/oauth/token
# XELTA_AUTH_USERINFO_URL=http://localhost:5000/api/auth/oauth/userinfo
# XELTA_AUTH_REDIRECT_URI=http://localhost:8000/auth/xelta/callback
# MCP_PUBLIC_BASE_URL=http://localhost:8000
# MCP_RESOURCE_URL=http://localhost:8000/mcp
# OAUTH_ISSUER=http://localhost:8000

# ── Development only ──────────────────────────────────────────────────────────
# Set to true to show a JWT paste field on the consent page.
# This bypasses the Xelta login redirect entirely and is for local testing ONLY.
# MUST be false in production.
ALLOW_MANUAL_JWT_CONSENT=false

# ── Xelta JWT (dev fallback only) ─────────────────────────────────────────────
# Only used if no OAuth session exists AND ALLOW_MANUAL_JWT_CONSENT is not used.
# Leave blank in production.
XELTA_JWT_TOKEN=

# ── Media uploads (Cloudflare R2) ─────────────────────────────────────────────
# Used by the upload_media tool / POST /media/upload. Uploads are stored at
# <R2_BUCKET_NAME>/<R2_UPLOAD_PREFIX>/u/<xelta_user_id>/ref/ and served publicly
# from R2_PUBLIC_BASE_URL. Leave the keys blank to disable uploads.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=xelta-ai
R2_PUBLIC_BASE_URL=https://media.xelta.ai
R2_UPLOAD_PREFIX=ad-multiplier
MEDIA_UPLOAD_MAX_MB=20
# Signs upload links. Falls back to CONSENT_SESSION_SECRET if blank.
MEDIA_UPLOAD_SECRET=

# ── Local server (server_local.py) ────────────────────────────────────────────
# Largest video accepted by the upload box. Any format and quality is fine: clips
# are converted to Kling O3's limits (and trimmed to 10s) before sending.
MEDIA_INTAKE_VIDEO_MAX_MB=500
MEDIA_INTAKE_VIDEO_MAX_SECONDS=120
# Folder containing ffmpeg and ffprobe, only if they aren't on PATH.
FFMPEG_PATH=

# ── Xelta service base URLs (defaults shown — only override if needed) ────────
XELTA_CREDITS_BASE_URL=https://pmt.xelta.ai
XELTA_AVATAR_BASE_URL=https://stgavatar.xelta.ai
XELTA_LIPSYNC_BASE_URL=https://lipsyncus.xelta.ai
XELTA_DUBBING_BASE_URL=https://stgdub.xelta.ai
XELTA_VOICERM_BASE_URL=https://voicerm.xelta.ai
XELTA_BEATSYNC_BASE_URL=https://beatsync.xelta.ai
XELTA_HOME_BASE_URL=https://stghome.xelta.ai
XELTA_SWAPPER_BASE_URL=https://swapper.xelta.ai
XELTA_MIXBOARD_BASE_URL=https://mixboard.xelta.ai
XELTA_COMIC_BASE_URL=https://stgcomic.xelta.ai
XELTA_PHOTOGPT_BASE_URL=https://stgphotogpt.xelta.ai
XELTA_STREETAD_BASE_URL=https://stgrf.xelta.ai
XELTA_MUSIC_BASE_URL=https://music.xelta.ai
XELTA_CHAT_BASE_URL=https://chatbotus.xelta.ai
